/* ================================
   CatPlan 全局样式 - 小黑猫可爱风
   主色调: 柔和薄荷绿 + 奶油紫
   辅色: 奶黄、樱花粉，整体偏浅色系
   ================================ */

/* 页面基础样式 */
page {
  background: linear-gradient(180deg, #fffaf5 0%, #fefcff 40%, #f5fbff 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 全局容器 */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 通用卡片样式 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

/* 卡片顶部装饰条 */
.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #95de64, #5cdbd3, #b37feb);
}

/* 主按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #95de64, #5cdbd3);
  color: #ffffff;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 30rpx rgba(92, 219, 211, 0.35);
  transition: all 0.3s ease;
}

.btn-primary[disabled] {
  background: #e6ebf0;
  color: #99a0aa;
  box-shadow: none;
}

/* 加载动画 */
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #5cdbd3;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 安全区域 */
.safe-area-bottom {
  height: calc(env(safe-area-inset-bottom) + 20rpx);
}

/* 小黑猫主题小组件（可选在各页面使用） */
.cat-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.cat-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.25);
}

.cat-hero-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cat-hero-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #262626;
}

.cat-hero-subtitle {
  font-size: 24rpx;
  color: #8c8c8c;
}
