.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffaf5 0%, #fefcff 40%, #f5fbff 100%);
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.page-header {
  text-align: center;
  padding-bottom: 24rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8c8c8c;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  font-size: 28rpx;
  color: #8c8c8c;
}

.task-sheet-detail {
  margin-top: 16rpx;
}

.header-card,
.progress-card,
.tasks-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.status-tag.status-pending {
  background: #faad14;
}

.status-tag.status-approved {
  background: #52c41a;
}

.status-tag.status-rejected {
  background: #ff4d4f;
}

.status-tag.status-completed {
  background: #5cdbd3;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #8c8c8c;
}

.date-icon {
  font-size: 28rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 28rpx;
  color: #595959;
}

.progress-percent {
  font-size: 32rpx;
  font-weight: 600;
  color: #52c41a;
}

.progress-bar {
  height: 20rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #95de64 0%, #5cdbd3 100%);
}

.progress-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: #f0f0f0;
}

.stat-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.stat-value.completed {
  color: #52c41a;
}

.stat-value.total {
  color: #262626;
}

.stat-value.remaining {
  color: #fa8c16;
}

.stat-label {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
}

.section-count {
  font-size: 24rpx;
  color: #8c8c8c;
}

.task-list {
  margin-top: 8rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.task-item.completed {
  background: #f6ffed;
  border-color: #b7eb8f;
}

.task-checkbox {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.checkbox-checked,
.checkbox-empty {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-checked {
  background: #52c41a;
  color: #ffffff;
  font-size: 24rpx;
  border-color: #52c41a;
}

.task-content {
  flex: 1;
}

.task-title {
  display: block;
  font-size: 28rpx;
  color: #262626;
  margin-bottom: 8rpx;
}

.task-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-points {
  font-size: 24rpx;
  color: #faad14;
}

.task-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.task-status.status-completed {
  background: #f6ffed;
  color: #52c41a;
}

.task-status.status-approved {
  background: #e6f7ff;
  color: #1890ff;
}

.task-status.status-rejected {
  background: #fff2f0;
  color: #ff4d4f;
}

.task-status.status-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.empty-tasks {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 16rpx;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8c8c8c;
  margin-bottom: 16rpx;
}

.add-task-btn {
  background: linear-gradient(135deg, #95de64, #5cdbd3);
  color: #fff;
  border: none;
  border-radius: 32rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #95de64, #5cdbd3);
  color: #ffffff;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #595959;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-container .empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-container .empty-text {
  font-size: 28rpx;
  color: #262626;
  margin-bottom: 16rpx;
}

.back-btn {
  margin-top: 8rpx;
  padding: 16rpx 40rpx;
  border-radius: 24rpx;
  border: 2rpx solid #d9d9d9;
  font-size: 26rpx;
  color: #595959;
  background: #ffffff;
}

