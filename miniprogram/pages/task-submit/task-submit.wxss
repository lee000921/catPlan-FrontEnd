.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffaf5 0%, #fefcff 40%, #f5fbff 100%);
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8c8c8c;
}

.form-section,
.section,
.preview-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
}

/* 小黑猫引导区域，靠近表单 */
.task-hero {
  margin-bottom: 24rpx;
}

/* 任务类型选择器：紧凑 checkbox 行样式 */
.type-toggle-row {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.type-chip {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 3rpx solid #f0f0f0;
  background: #fdfbff;
  transition: all 0.2s;
}

.type-chip.active {
  border-color: #5cdbd3;
  background: #f0fffb;
  box-shadow: 0 4rpx 16rpx rgba(92, 219, 211, 0.25);
}

.type-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 10rpx;
  border: 3rpx solid #d9d9d9;
  margin-right: 12rpx;
  position: relative;
  box-sizing: border-box;
}

.type-check.checked {
  border-color: #5cdbd3;
  background: #5cdbd3;
}

.type-check.checked::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 2rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.type-chip-text {
  font-size: 28rpx;
  color: #262626;
  font-weight: 500;
}

/* 输入区域 */
.input-area {
  position: relative;
}

.form-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 24rpx;
  padding-right: 220rpx;
  border: 3rpx solid #f0f0f0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #000000 !important;
  -webkit-text-fill-color: #000000 !important;
  font-weight: 500;
  box-sizing: border-box;
  background: #fdfbff;
  transition: all 0.3s;
}

.form-input:focus {
  border-color: #5cdbd3;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(92, 219, 211, 0.18);
}

.input-counter {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #8c8c8c;
  background: #fff;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 文本域 */
.textarea-area {
  position: relative;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  padding-bottom: 60rpx;
  border: 3rpx solid #f0f0f0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #000000 !important;
  -webkit-text-fill-color: #000000 !important;
  font-weight: 500;
  line-height: 1.8;
  box-sizing: border-box;
  background: #fdfbff;
  resize: none;
  transition: all 0.3s;
}

/* 输入/文本域占位符字体统一 */
.field-placeholder {
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #bfbfbf;
}

.form-textarea:focus {
  border-color: #5cdbd3;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(92, 219, 211, 0.18);
}

.textarea-counter {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

/* 积分输入 */
.points-area {
  background: linear-gradient(135deg, #fef6e6 0%, #ffffff 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 3rpx solid #ffe58f;
}

.points-input-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.points-prefix {
  font-size: 40rpx;
  font-weight: 700;
  color: #faad14;
  margin-right: 12rpx;
}

.points-input {
  flex: 1;
  font-size: 52rpx;
  font-weight: 700;
  color: #faad14;
  text-align: center;
  border: none;
  background: transparent;
}

.points-suffix {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-left: 12rpx;
}

.points-tips {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: rgba(250, 173, 20, 0.06);
  border-radius: 12rpx;
}

.tips-icon {
  font-size: 28rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #595959;
  line-height: 1.5;
}

/* 周期配置 */
.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #595959;
  margin-bottom: 16rpx;
}

.radio-group {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.radio-item {
  padding: 20rpx;
  border: 3rpx solid #f0f0f0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8c8c8c;
  transition: all 0.3s;
  background: #fdfbff;
}

.radio-item.active {
  border-color: #5cdbd3;
  background: linear-gradient(180deg, #f0fffb 0%, #e6fffb 100%);
  color: #5cdbd3;
  font-weight: 700;
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
}

.weekday-selector {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.weekday-item {
  min-height: 72rpx;
  padding: 20rpx 0;
  border: 3rpx solid #f0f0f0;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8c8c8c;
  transition: all 0.3s;
  background: #fdfbff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.weekday-item.selected {
  border-color: #5cdbd3;
  background: linear-gradient(135deg, #95de64 0%, #5cdbd3 100%);
  color: #fff;
  font-weight: 700;
  transform: scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(92, 219, 211, 0.35);
}

.picker {
  padding: 24rpx;
  border: 3rpx solid #f0f0f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #262626;
  background: #ffffff;
}

/* 任务预览卡片 */
.preview-card {
  background: linear-gradient(135deg, #fffbe6 0%, #ffffff 100%);
  border-radius: 20rpx;
  overflow: hidden;
  border: 3rpx solid #ffe58f;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(250, 173, 20, 0.15);
}

.preview-header {
  padding: 24rpx 32rpx;
  background: linear-gradient(90deg, rgba(250, 173, 20, 0.12) 0%, rgba(250, 173, 20, 0.06) 100%);
  border-bottom: 2rpx solid rgba(250, 173, 20, 0.15);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-badge {
  font-size: 24rpx;
  color: #d48806;
  background: rgba(250, 173, 20, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.preview-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #262626;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-body {
  padding: 28rpx 32rpx;
}

.preview-desc {
  display: block;
  font-size: 28rpx;
  color: #595959;
  line-height: 1.8;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.preview-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-points {
  font-size: 36rpx;
  font-weight: 700;
  color: #faad14;
}

.preview-periodic {
  font-size: 26rpx;
  color: #5cdbd3;
  background: #f0fffb;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

/* 底部提示与提交按钮 */
.tips-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.tips-section .tips-icon {
  font-size: 26rpx;
}

.tips-section .tips-text {
  font-size: 26rpx;
  color: #8c8c8c;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #95de64 0%, #5cdbd3 100%);
  color: #ffffff;
  border: none;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(92, 219, 211, 0.45);
  transition: all 0.3s;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(92, 219, 211, 0.40);
}

.submit-btn[disabled] {
  background: #e0e0e0;
  box-shadow: none;
  color: #999;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 34rpx;
  font-weight: 700;
}

.btn-loading {
  font-size: 30rpx;
}
