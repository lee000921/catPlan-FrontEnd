/* TEST FILE - 2026-03-09 01:00 - NEW VERSION */
/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffaf5 0%, #fefcff 40%, #f5fbff 100%);
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.page-header {
  text-align: center;
  padding-bottom: 24rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8c8c8c;
}

.guest-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #b7eb8f;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f6ffed, #e6fffb);
}

.guest-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.guest-title {
  color: #237804;
  font-size: 28rpx;
  font-weight: 700;
}

.guest-desc {
  margin-top: 6rpx;
  color: #52734d;
  font-size: 22rpx;
  line-height: 1.5;
}

.guest-login-btn {
  margin: 0;
  padding: 0 22rpx;
  border: none;
  border-radius: 28rpx;
  background: #52c41a;
  color: #fff;
  font-size: 24rpx;
  line-height: 60rpx;
}

.guest-login-btn::after {
  border: none;
}

/* 用户卡片 */
.user-card {
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.12);
}

.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-avatar-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.18);
}

.user-info-text {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
}

.user-role {
  font-size: 24rpx;
  color: #bfbfbf;
  margin-top: 4rpx;
}

.user-points {
  font-size: 24rpx;
  color: #faad14;
  margin-top: 4rpx;
  font-weight: 500;
}

.user-actions {
  display: flex;
  gap: 12rpx;
}

.role-switch-btn,
.logout-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
}

.role-switch-btn {
  background: #f0fffb;
  color: #5cdbd3;
}

.logout-btn {
  background: #2f3442;
  color: #fefefe;
}

/* 统计卡片 */
.stats-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.1);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
}

.stats-subtitle {
  font-size: 24rpx;
  color: #a0a0a0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #fdfbff;
  border-radius: 16rpx;
}

.stat-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 600;
  color: #5cdbd3;
}

.stat-label {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}

/* 审批者视图切换 */
.view-switcher {
  margin: 24rpx 0;
}

.switcher-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #a0a0a0;
  position: relative;
}

.tab-item.active {
  background: #f0fffb;
  color: #5cdbd3;
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: #fa8c16;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  min-width: 24rpx;
  text-align: center;
}

/* 任务列表 */
.task-scroll {
  height: calc(100vh - 420rpx);
}

.task-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.task-card {
  width: 92%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 34rpx rgba(0, 0, 0, 0.12);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.task-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.task-card.approval-view {
  border-left: 6rpx solid #5cdbd3;
}

/* 状态指示条 */
.status-indicator {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
}

.status-indicator.status-pending {
  background: linear-gradient(90deg, #ffd666, #ffa940);
}

.status-indicator.status-approved {
  background: linear-gradient(90deg, #95de64, #5cdbd3);
}

.status-indicator.status-rejected {
  background: linear-gradient(90deg, #ff7875, #ff9c6e);
}

.status-indicator.status-completed {
  background: linear-gradient(90deg, #b7eb8f, #95de64);
}

/* 任务头部 */
.task-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.task-title-section {
  flex: 1;
}

.task-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.task-meta {
  display: flex;
  gap: 12rpx;
}

.task-date,
.task-id {
  font-size: 22rpx;
  color: #8c8c8c;
}

.task-status-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #fdfbff;
  color: #a0a0a0;
}

.status-icon {
  font-size: 24rpx;
}

/* 任务描述 */
.task-desc {
  margin-bottom: 16rpx;
}

.desc-text {
  display: block;
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 审批信息 */
.approval-info {
  background: #fdfbff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.approval-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.approval-date {
  font-size: 22rpx;
  color: #8c8c8c;
}

.approval-status-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.approval-status-badge.approved {
  background: #f0fffb;
  color: #5cdbd3;
}

.approval-status-badge.rejected {
  background: #fff2e8;
  color: #ff7a45;
}

.approval-comment {
  font-size: 24rpx;
  color: #595959;
  line-height: 1.4;
}

/* 任务底部 */
.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.task-points {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.points-icon {
  font-size: 24rpx;
}

.points-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #faad14;
}

.points-label {
  font-size: 24rpx;
  color: #8c8c8c;
}

.task-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #5cdbd3;
}

.action-arrow {
  font-size: 28rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #5cdbd3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8c8c8c;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #8c8c8c;
}

.safe-bottom {
  height: 40rpx;
}

/* FAB 悬浮按钮（右下角两个操作按钮） */
.fab-container {
  position: fixed;
  bottom: 80rpx;
  right: 32rpx;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.fab-extended {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-end;
}

.fab-ext-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffffff 0%, #f0fffb 100%);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  border: none;
  gap: 12rpx;
  white-space: nowrap;
  width: 260rpx;
}

.fab-ext-btn:active {
  background: #e6fffb;
  transform: scale(0.95);
}

.ext-icon {
  font-size: 32rpx;
}

.ext-text {
  font-size: 26rpx;
  color: #262626;
  font-weight: 500;
}
