<view class="profile-container">
  <view class="user-section">
    <image class="avatar" src="{{userInfo.avatarUrl || '../../assets/cat-lxh.png'}}" mode="aspectFill"></image>
    <view class="info">
      <text class="nickname">{{userInfo.nickName || 'CatPlan 用户'}}</text>
      <text class="role">角色：{{userTypeLabel}}</text>
      <view class="points-box">
        <text class="points-label">当前碎片</text>
        <text class="points-value">{{points}}</text>
      </view>
    </view>
  </view>

  <view class="history-section">
    <text class="section-title">积分明细</text>

    <view wx:if="{{loading && records.length === 0}}" class="loading">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{!loading && records.length === 0}}" class="empty">
      <text>暂无积分记录</text>
    </view>

    <view wx:else class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-left">
          <text class="record-reason">{{item.reason}}</text>
          <text class="record-time">{{item.createdDate}}</text>
        </view>
        <view class="record-right">
          <text class="record-change {{item.points_change > 0 ? 'positive' : 'negative'}}">
            {{item.points_change > 0 ? '+' : ''}}{{item.points_change}}
          </text>
          <text class="record-balance">余额：{{item.balance}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{hasMore && records.length > 0}}" class="load-more" bindtap="loadMore">
      <text>{{loading ? '加载中...' : '加载更多'}}</text>
    </view>
  </view>
</view>
