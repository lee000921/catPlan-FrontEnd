<view class="container">
  <view class="card">
    <view class="cat-hero">
      <image class="cat-image" src="../../assets/cat-lxh.png" mode="aspectFit" />
      <view class="cat-hero-text">
        <text class="cat-hero-title">小黑在帮你记任务</text>
        <text class="cat-hero-subtitle">每天一点点，碎片慢慢攒</text>
      </view>
    </view>

    <image class="logo" src="../../assets/logo.png" mode="aspectFit" wx:if="{{false}}" />
    <view class="title">CatPlan 任务计划</view>
    
    <!-- 角色由服务端账号配置决定，客户端不授予权限。 -->
    <view class="role-section" wx:if="{{!logged}}">
      <view class="section-title">按需登录</view>
      <view class="role-desc">你可以先浏览任务、签到和积分商城，再决定是否登录。</view>
      <view class="privacy-note">登录不会申请手机号、头像或昵称。</view>
    </view>

    <view class="profile" wx:if="{{logged}}">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="nick">{{userInfo.nickName}}</view>
    </view>

    <view class="actions">
      <button class="browse-btn" bindtap="onBrowseTap" wx:if="{{!logged}}">先浏览功能</button>
      <button class="login-btn" bindtap="onLoginTap" loading="{{submitting}}" disabled="{{submitting}}" wx:if="{{!logged}}">进入 CatPlan</button>
      <button class="logout-btn" bindtap="onLogout" wx:if="{{logged}}">退出登录</button>
    </view>

    <view class="status" wx:if="{{message}}">{{message}}</view>
  </view>
</view>
